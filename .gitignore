# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment & local secrets (NEVER commit actual credentials or secrets)
.env
.env.*
*.env
**/.env
**/.env.*
**/.*.env

# Keep template example env files only
!.env.example
!**/.env.example

# Uploaded documents and receipts
storage/documents/*
!storage/documents/.gitkeep
storage/receipts/*
!storage/receipts/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Internal / temp artifacts
.system_generated/
.tempmediaStorage/
backups/
*.dump

