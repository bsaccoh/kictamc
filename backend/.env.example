# Database Configuration
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/kictamc_portal?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1
FRONTEND_URL="http://localhost:5173"

# Authentication & Security
JWT_ACCESS_SECRET="kictamc-development-access-secret-change-in-production-2026"
JWT_REFRESH_SECRET="kictamc-development-refresh-secret-change-in-production-2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
COOKIE_SECRET="kictamc-cookie-secret-key-32chars-min-length"

# Storage
STORAGE_DIR="./storage"
MAX_FILE_SIZE_BYTES=5242880 # 5MB

# Notifications (Console / Mock mode in development)
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"
APP_NAME="KICTAMC Portal"
COLLEGE_EMAIL="admissions@kictamc.edu.sl"
COLLEGE_PHONE="+232-76-000000"

# Initial Seed Credentials (Configure before seeding in development or staging)
SEED_ADMIN_PASSWORD="YourSecureAdminPassword123!"
SEED_ADMISSIONS_PASSWORD="YourSecureAdmissionsPassword123!"
SEED_FINANCE_PASSWORD="YourSecureFinancePassword123!"
SEED_APPLICANT_PASSWORD="YourSecureApplicantPassword123!"
